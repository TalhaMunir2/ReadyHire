rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownUser(uid) { return signedIn() && request.auth.uid == uid; }
    function roleIs(role) {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    match /users/{uid} {
      allow create: if ownUser(uid);
      allow read, update: if ownUser(uid) || roleIs('admin');
      allow delete: if roleIs('admin');
    }

    match /candidates/{candidateId} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update: if signedIn() && (request.auth.uid == candidateId || roleIs('recruiter') || roleIs('admin'));
      allow delete: if roleIs('admin');
    }

    match /reports/{reportId} {
      allow read, create: if roleIs('recruiter') || roleIs('admin');
      allow update, delete: if roleIs('admin');
    }
  }
}
